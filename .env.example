# Copia este archivo como .env.local (no se versiona) solo si necesitas cambiar los valores.
# El frontend no necesita variables en tiempo de ejecución: la API se consume desde el mismo
# origen (/api) mediante el proxy de Vite en desarrollo y nginx en contenedores.

# Backend al que el servidor de desarrollo de Vite reenvía /api y /actuator/health.
BACKEND_URL=http://localhost:8090
