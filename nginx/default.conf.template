# Plantilla procesada por la imagen de nginx al arrancar: ${BACKEND_URL} se reemplaza con la
# variable de entorno. Las variables propias de nginx ($host, $uri...) no se tocan.

# Detrás de Cloudflare Tunnel (perfil tunnel del backend), cloudflared llega desde la red de Docker:
# la IP real del visitante viene en CF-Connecting-IP. Solo se acepta esa cabecera de las redes
# privadas (cloudflared o el propio equipo); así el límite por IP de abajo aplica a cada visitante.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

# Esquema original de la petición: https si viene de un proxy que terminó TLS (cloudflared envía
# X-Forwarded-Proto); si no, el de esta conexión. El backend lo usa para comparar el origen.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Límite por IP para inicio de sesión y registro (D16). Complementa el bloqueo por cuenta del
# backend: frena los intentos repartidos entre muchas cuentas desde una misma dirección.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    limit_req_status 429;

    # API y health check del backend, servidos desde el mismo origen (ADR-0007).
    # Las cabeceras de seguridad de estas respuestas las pone Spring Security.
    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location ~ ^/api/v1/auth/(login|register)$ {
        limit_req zone=auth burst=5 nodelay;
        error_page 429 = @too_many_requests;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    # Misma forma que los errores de la API (RFC 9457) para que el frontend muestre el mensaje.
    location @too_many_requests {
        default_type application/problem+json;
        return 429 '{"status":429,"code":"too_many_requests","title":"Demasiadas solicitudes","detail":"Hiciste demasiados intentos seguidos. Espera un minuto e intenta de nuevo."}';
    }

    location = /actuator/health {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    # Archivos con hash en el nombre: se pueden cachear para siempre.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta devuelve index.html, que nunca se cachea.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
